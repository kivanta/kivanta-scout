---
const checks = [
  {
    number: "01",
    title: "What does this tool actually do?",
    description:
      "Scout traces source behavior, entry points, configuration, dependencies and material effects.",
  },
  {
    number: "02",
    title: "Your Key, Password & Sensitive Information",
    description:
      "Scout examines how sensitive information is read, stored, transmitted or exposed.",
  },
  {
    number: "03",
    title: "Where Does It Connect?",
    description:
      "Scout establishes material network destinations and unresolved connection paths.",
  },
  {
    number: "04",
    title: "Does It Match the Official Technocore Reference?",
    description:
      "Observed behavior is compared against Scout’s versioned authoritative reference.",
  },
  {
    number: "05",
    title: "What Should I Know Before I Use It?",
    description:
      "Scout surfaces material facts, limitations and precautions established by the evidence.",
  },
];

const scanStages = [
  {
    key: "discovery",
    label: "Discovery",
    description: "Following public project and identity clues",
  },
  {
    key: "source",
    label: "Source",
    description: "Establishing the supported public source",
  },
  {
    key: "evidence",
    label: "Evidence",
    description: "Inspecting source-backed behavior",
  },
  {
    key: "methodology",
    label: "Methodology",
    description: "Preparing the five evidence checks",
  },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="description"
      content="Kivanta Scout — evidence-first verification for public Technocore tools and agents."
    />

    <title>Kivanta Scout</title>
  </head>

  <body>
    <div class="ambient ambient-one"></div>
    <div class="ambient ambient-two"></div>
    <div class="ambient ambient-three"></div>

    <main class="site-shell">
      <header class="navbar">
        <a
          class="brand"
          href="/"
          aria-label="Kivanta Scout home"
        >
          <span class="brand-mark">
            K
          </span>

          <span class="brand-copy">
            <strong>Kivanta</strong>
            <span>Scout</span>
          </span>
        </a>

        <div class="nav-meta">
          <span class="network-dot"></span>
          <span>Methodology 1.0</span>
        </div>
      </header>

      <section class="hero">
        <div class="hero-copy">
          <div class="eyebrow">
            <span class="eyebrow-dot"></span>
            Evidence before claims
          </div>

          <h1>
            Understand a Technocore tool
            <span>before you use it.</span>
          </h1>

          <p class="hero-description">
            Paste a project or agent. Scout follows the
            public evidence, establishes the supported
            source when possible, and shows you what the
            code actually does.
          </p>

          <form
            class="scout-form"
            id="scout-form"
          >
            <label
              for="scout-input"
              class="input-label"
            >
              Paste a project or agent
            </label>

            <div class="input-shell">
              <input
                id="scout-input"
                name="input"
                type="text"
                autocomplete="off"
                spellcheck="false"
                placeholder="Website, GitHub, Technocore link, did:key or ENS"
              />

              <button
                type="submit"
                id="scout-button"
              >
                <span>Scout it</span>

                <svg
                  viewBox="0 0 20 20"
                  aria-hidden="true"
                >
                  <path
                    d="M4 10h11M11 6l4 4-4 4"
                  />
                </svg>
              </button>
            </div>

            <div class="input-hints">
              <span>Website</span>
              <span>GitHub</span>
              <span>Technocore</span>
              <span>did:key</span>
              <span>ENS</span>
            </div>

            <div
              class="scan-progress"
              id="scan-progress"
              aria-live="polite"
              aria-hidden="true"
            >
              <div class="scan-progress-head">
                <div>
                  <span class="scan-progress-kicker">
                    Scout activity
                  </span>

                  <strong id="scan-progress-title">
                    Ready to investigate
                  </strong>
                </div>

                <span
                  class="scan-progress-state"
                  id="scan-progress-state"
                >
                  Idle
                </span>
              </div>

              <div class="scan-progress-track">
                {
                  scanStages.map((stage, index) => (
                    <div
                      class="scan-step"
                      data-scan-step={stage.key}
                    >
                      <span class="scan-step-marker">
                        {String(index + 1).padStart(2, "0")}
                      </span>

                      <div>
                        <strong>
                          {stage.label}
                        </strong>

                        <span>
                          {stage.description}
                        </span>
                      </div>
                    </div>
                  ))
                }
              </div>
            </div>
          </form>
        </div>

        <div
          class="probe-stage"
          id="probe-stage"
          aria-hidden="true"
        >
          <div class="probe-grid"></div>

          <div class="orbit orbit-one"></div>
          <div class="orbit orbit-two"></div>

          <div class="scan-line"></div>

          <div class="probe">
            <div class="probe-core">
              <div class="probe-eye"></div>
            </div>

            <div class="probe-ring"></div>
            <div class="probe-pulse"></div>
          </div>

          <div
            class="probe-label label-discovery"
            data-probe-stage="discovery"
          >
            <span></span>
            Discovery
          </div>

          <div
            class="probe-label label-source"
            data-probe-stage="source"
          >
            <span></span>
            Source
          </div>

          <div
            class="probe-label label-evidence"
            data-probe-stage="evidence"
          >
            <span></span>
            Evidence
          </div>

          <div
            class="probe-label label-methodology"
            data-probe-stage="methodology"
          >
            <span></span>
            Methodology
          </div>
        </div>
      </section>

      <section
        class="status-panel"
        id="status-panel"
      >
        <div class="status-top">
          <div>
            <span class="section-kicker">
              Methodology 1.0
            </span>

            <h2 id="status-heading">
              Five checks. Evidence attached.
            </h2>
          </div>

          <div
            class="status-badge"
            id="status-badge"
          >
            <span></span>
            <strong id="status-badge-label">
              Ready
            </strong>
          </div>
        </div>

        <div
          class="checks-grid"
          id="checks-grid"
        >
          {
            checks.map((check) => (
              <article class="check-card">
                <div class="check-number">
                  {check.number}
                </div>

                <div>
                  <h3>
                    {check.title}
                  </h3>

                  <p>
                    {check.description}
                  </p>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section class="principles">
        <div class="principle">
          <span class="principle-icon">
            01
          </span>

          <div>
            <strong>
              Discovery first
            </strong>

            <p>
              Scout does not force unclear inputs
              through the methodology.
            </p>
          </div>
        </div>

        <div class="principle">
          <span class="principle-icon">
            02
          </span>

          <div>
            <strong>
              Source before findings
            </strong>

            <p>
              A candidate repository is not automatically
              a supported source.
            </p>
          </div>
        </div>

        <div class="principle">
          <span class="principle-icon">
            03
          </span>

          <div>
            <strong>
              Evidence stays visible
            </strong>

            <p>
              PASS, CAUTION and UNKNOWN retain their
              supporting observations.
            </p>
          </div>
        </div>
      </section>

      <footer>
        <span>Kivanta Scout</span>

        <span>
          Evidence-first verification
        </span>
      </footer>
    </main>

    <script>
      const form =
        document.querySelector<HTMLFormElement>(
          "#scout-form"
        );

      const input =
        document.querySelector<HTMLInputElement>(
          "#scout-input"
        );

      const button =
        document.querySelector<HTMLButtonElement>(
          "#scout-button"
        );

      const buttonLabel =
        button?.querySelector<HTMLSpanElement>(
          "span"
        );

      const scanProgress =
        document.querySelector<HTMLElement>(
          "#scan-progress"
        );

      const scanProgressTitle =
        document.querySelector<HTMLElement>(
          "#scan-progress-title"
        );

      const scanProgressState =
        document.querySelector<HTMLElement>(
          "#scan-progress-state"
        );

      const probeStage =
        document.querySelector<HTMLElement>(
          "#probe-stage"
        );

      const statusPanel =
        document.querySelector<HTMLElement>(
          "#status-panel"
        );

      const statusHeading =
        document.querySelector<HTMLElement>(
          "#status-heading"
        );

      const statusBadge =
        document.querySelector<HTMLElement>(
          "#status-badge"
        );

      const statusBadgeLabel =
        document.querySelector<HTMLElement>(
          "#status-badge-label"
        );

      const checksGrid =
        document.querySelector<HTMLElement>(
          "#checks-grid"
        );

      const scanSteps =
        Array.from(
          document.querySelectorAll<HTMLElement>(
            "[data-scan-step]"
          )
        );

      const probeLabels =
        Array.from(
          document.querySelectorAll<HTMLElement>(
            "[data-probe-stage]"
          )
        );

      const stageOrder = [
        {
          key: "discovery",
          title: "Discovering the project",
          delay: 0,
        },
        {
          key: "source",
          title: "Establishing the source",
          delay: 950,
        },
        {
          key: "evidence",
          title: "Inspecting public evidence",
          delay: 1900,
        },
        {
          key: "methodology",
          title: "Preparing Methodology 1.0",
          delay: 2850,
        },
      ];

      let activeTimers: number[] = [];

      function clearTimers() {
        for (const timer of activeTimers) {
          window.clearTimeout(timer);
        }

        activeTimers = [];
      }

      function resetStages() {
        for (const step of scanSteps) {
          step.classList.remove(
            "is-active",
            "is-complete"
          );
        }

        for (const label of probeLabels) {
          label.classList.remove(
            "is-active",
            "is-complete"
          );
        }
      }

      function setStage(
        key: string,
        title: string
      ) {
        const activeIndex =
          stageOrder.findIndex(
            (stage) =>
              stage.key === key
          );

        scanSteps.forEach(
          (step, index) => {
            step.classList.remove(
              "is-active",
              "is-complete"
            );

            if (index < activeIndex) {
              step.classList.add(
                "is-complete"
              );
            }

            if (index === activeIndex) {
              step.classList.add(
                "is-active"
              );
            }
          }
        );

        probeLabels.forEach(
          (label) => {
            label.classList.remove(
              "is-active",
              "is-complete"
            );

            const labelKey =
              label.dataset
                .probeStage;

            const labelIndex =
              stageOrder.findIndex(
                (stage) =>
                  stage.key === labelKey
              );

            if (
              labelIndex <
              activeIndex
            ) {
              label.classList.add(
                "is-complete"
              );
            }

            if (
              labelKey === key
            ) {
              label.classList.add(
                "is-active"
              );
            }
          }
        );

        if (scanProgressTitle) {
          scanProgressTitle.textContent =
            title;
        }
      }

      function beginScanning() {
        clearTimers();
        resetStages();

        scanProgress?.classList.add(
          "is-visible"
        );

        scanProgress?.setAttribute(
          "aria-hidden",
          "false"
        );

        probeStage?.classList.add(
          "is-scanning"
        );

        statusPanel?.classList.add(
          "is-scanning"
        );

        checksGrid?.classList.add(
          "is-scanning"
        );

        statusBadge?.classList.add(
          "is-scanning"
        );

        if (statusBadgeLabel) {
          statusBadgeLabel.textContent =
            "Scanning";
        }

        if (statusHeading) {
          statusHeading.textContent =
            "Scout is investigating.";
        }

        if (scanProgressState) {
          scanProgressState.textContent =
            "Running";
        }

        if (button) {
          button.disabled =
            true;
        }

        button?.classList.add(
          "is-working"
        );

        if (buttonLabel) {
          buttonLabel.textContent =
            "Scouting...";
        }

        stageOrder.forEach(
          (stage) => {
            const timer =
              window.setTimeout(
                () => {
                  setStage(
                    stage.key,
                    stage.title
                  );
                },
                stage.delay
              );

            activeTimers.push(
              timer
            );
          }
        );

        const completeTimer =
          window.setTimeout(
            () => {
              finishScanning();
            },
            3900
          );

        activeTimers.push(
          completeTimer
        );
      }

      function finishScanning() {
        scanSteps.forEach(
          (step) => {
            step.classList.remove(
              "is-active"
            );

            step.classList.add(
              "is-complete"
            );
          }
        );

        probeLabels.forEach(
          (label) => {
            label.classList.remove(
              "is-active"
            );

            label.classList.add(
              "is-complete"
            );
          }
        );

        if (scanProgressTitle) {
          scanProgressTitle.textContent =
            "Scan sequence ready";
        }

        if (scanProgressState) {
          scanProgressState.textContent =
            "Complete";
        }

        if (statusHeading) {
          statusHeading.textContent =
            "Five checks. Evidence attached.";
        }

        if (statusBadgeLabel) {
          statusBadgeLabel.textContent =
            "Ready";
        }

        statusBadge?.classList.remove(
          "is-scanning"
        );

        statusBadge?.classList.add(
          "is-complete"
        );

        probeStage?.classList.remove(
          "is-scanning"
        );

        statusPanel?.classList.remove(
          "is-scanning"
        );

        checksGrid?.classList.remove(
          "is-scanning"
        );

        button?.classList.remove(
          "is-working"
        );

        if (button) {
          button.disabled =
            false;
        }

        if (buttonLabel) {
          buttonLabel.textContent =
            "Scout it";
        }
      }

      form?.addEventListener(
        "submit",
        (event) => {
          event.preventDefault();

          const value =
            input?.value.trim();

          if (!value) {
            input?.focus();
            return;
          }

          beginScanning();
        }
      );
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;

    --background: #02060d;
    --background-soft: #050c16;

    --card: rgba(5, 13, 22, 0.9);
    --card-solid: #061019;

    --border: rgba(137, 190, 255, 0.1);
    --border-strong: rgba(137, 190, 255, 0.18);

    --text: #f3f7fa;
    --text-soft: #a8b6bf;
    --text-dim: #657884;

    --green: #8ff7b7;
    --cyan: #65e6ed;
    --blue: #3b82f6;

    --max-width: 1180px;
  }

  * {
    box-sizing: border-box;
  }

  html {
    background:
      var(--background);

    scroll-behavior:
      smooth;
  }

  body {
    min-height: 100vh;

    margin: 0;

    overflow-x: hidden;

    background:
      radial-gradient(
        circle at 8% 5%,
        rgba(52, 115, 255, 0.12),
        transparent 34%
      ),
      radial-gradient(
        circle at 88% 46%,
        rgba(25, 173, 255, 0.08),
        transparent 38%
      ),
      linear-gradient(
        180deg,
        #02060d 0%,
        #02070d 46%,
        #03090e 100%
      );

    color:
      var(--text);

    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  button,
  input {
    font: inherit;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .site-shell {
    position: relative;
    z-index: 2;

    width:
      min(
        calc(100% - 40px),
        var(--max-width)
      );

    margin: 0 auto;
  }

  .ambient {
    position: fixed;
    z-index: 0;

    border-radius: 999px;

    filter: blur(145px);

    pointer-events: none;

    animation:
      ambientMove
      22s
      ease-in-out
      infinite
      alternate;
  }

  .ambient-one {
    top: -300px;
    left: -220px;

    width: 720px;
    height: 720px;

    background:
      #246bff;

    opacity:
      0.14;
  }

  .ambient-two {
    top: 180px;
    right: -330px;

    width: 680px;
    height: 680px;

    background:
      #21c7f4;

    opacity:
      0.11;

    animation-delay:
      -8s;
  }

  .ambient-three {
    bottom: -380px;
    left: 28%;

    width: 760px;
    height: 760px;

    background:
      #5c7cff;

    opacity:
      0.07;

    animation-delay:
      -14s;
  }

  @keyframes ambientMove {
    0% {
      transform:
        translate3d(
          -5%,
          -3%,
          0
        )
        scale(0.95);
    }

    100% {
      transform:
        translate3d(
          8%,
          6%,
          0
        )
        scale(1.08);
    }
  }

  .navbar {
    min-height: 88px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    border-bottom:
      1px solid
      var(--border);
  }

  .brand {
    display: flex;
    align-items: center;

    gap: 12px;
  }

  .brand-mark {
    width: 38px;
    height: 38px;

    display: grid;
    place-items: center;

    border:
      1px solid
      rgba(101, 230, 237, 0.18);

    border-radius:
      10px;

    background:
      linear-gradient(
        145deg,
        rgba(59, 130, 246, 0.18),
        rgba(101, 230, 237, 0.05)
      );

    color:
      var(--green);

    font-weight:
      800;
  }

  .brand-copy {
    display: flex;
    flex-direction: column;

    line-height:
      1.05;
  }

  .brand-copy strong {
    font-size:
      15px;

    letter-spacing:
      0.01em;
  }

  .brand-copy span {
    margin-top:
      4px;

    color:
      var(--text-dim);

    font-size:
      12px;

    letter-spacing:
      0.12em;

    text-transform:
      uppercase;
  }

  .nav-meta {
    display: flex;
    align-items: center;

    gap: 9px;

    color:
      var(--text-soft);

    font-size:
      12px;
  }

  .network-dot,
  .status-badge span,
  .eyebrow-dot {
    width: 7px;
    height: 7px;

    border-radius:
      999px;

    background:
      var(--green);

    box-shadow:
      0 0 18px
      rgba(143, 247, 183, 0.65);
  }

  .hero {
    min-height:
      620px;

    display: grid;

    grid-template-columns:
      minmax(0, 1.08fr)
      minmax(360px, 0.92fr);

    gap:
      70px;

    align-items:
      center;

    padding:
      76px 0 72px;
  }

  .hero-copy {
    position:
      relative;

    z-index:
      3;
  }

  .eyebrow {
    display:
      inline-flex;

    align-items:
      center;

    gap:
      10px;

    margin-bottom:
      22px;

    color:
      var(--green);

    font-size:
      12px;

    font-weight:
      700;

    letter-spacing:
      0.12em;

    text-transform:
      uppercase;
  }

  h1 {
    max-width:
      720px;

    margin:
      0;

    font-size:
      clamp(
        44px,
        5.4vw,
        70px
      );

    line-height:
      1;

    letter-spacing:
      -0.055em;
  }

  h1 span {
    display:
      block;

    margin-top:
      8px;

    color:
      var(--text-soft);
  }

  .hero-description {
    max-width:
      650px;

    margin:
      24px 0 28px;

    color:
      var(--text-soft);

    font-size:
      clamp(
        16px,
        1.5vw,
        19px
      );

    line-height:
      1.7;
  }

  .scout-form {
    max-width:
      720px;
  }

  .input-label {
    display:
      block;

    margin-bottom:
      9px;

    color:
      var(--text-soft);

    font-size:
      12px;

    font-weight:
      700;

    letter-spacing:
      0.04em;
  }

  .input-shell {
    display:
      grid;

    grid-template-columns:
      minmax(0, 1fr)
      auto;

    gap:
      8px;

    padding:
      7px;

    border:
      1px solid
      rgba(101, 184, 255, 0.2);

    border-radius:
      15px;

    background:
      rgba(3, 9, 16, 0.94);

    box-shadow:
      0 24px 90px
      rgba(0, 0, 0, 0.38);
  }

  .input-shell:focus-within {
    border-color:
      rgba(101, 230, 237, 0.42);

    box-shadow:
      0 0 0 3px
      rgba(101, 230, 237, 0.045),
      0 25px 100px
      rgba(0, 0, 0, 0.42);
  }

  .input-shell input {
    width:
      100%;

    min-width:
      0;

    border:
      0;

    outline:
      0;

    padding:
      0 14px;

    background:
      transparent;

    color:
      var(--text);

    font-size:
      15px;
  }

  .input-shell input::placeholder {
    color:
      #526777;
  }

  .input-shell button {
    min-height:
      48px;

    display:
      inline-flex;

    align-items:
      center;

    gap:
      8px;

    border:
      0;

    border-radius:
      10px;

    padding:
      0 18px;

    background:
      linear-gradient(
        135deg,
        #91f7b9,
        #72e8c8
      );

    color:
      #04100a;

    cursor:
      pointer;

    font-size:
      13px;

    font-weight:
      800;

    box-shadow:
      0 8px 28px
      rgba(104, 236, 188, 0.11);

    transition:
      transform 160ms ease,
      opacity 160ms ease,
      box-shadow 160ms ease;
  }

  .input-shell button:hover:not(:disabled) {
    transform:
      translateY(-1px);

    box-shadow:
      0 10px 34px
      rgba(104, 236, 188, 0.17);
  }

  .input-shell button:disabled {
    cursor:
      wait;
  }

  .input-shell button.is-working {
    opacity:
      0.72;
  }

  .input-shell button svg {
    width:
      17px;

    height:
      17px;

    fill:
      none;


<!-- =========================================================
     KIVANTA SCOUT
     HOW IT WORKS
========================================================= -->

<section
  class="how-it-works"
  id="how-it-works"
>

  <div class="how-it-works__inner">

    <!-- =====================================================
         SECTION INTRO
    ====================================================== -->

    <div class="how-it-works__intro">

      <div class="section-eyebrow">
        <span class="section-eyebrow__dot"></span>
        How Scout works
      </div>


      <h2 class="how-it-works__title">
        From a public reference
        <span>to evidence you can inspect.</span>
      </h2>


      <p class="how-it-works__description">
        Scout separates discovery from investigation.
        It first works out what project you are referring to,
        then establishes whether there is a supported public source
        before producing methodology findings.
      </p>

    </div>


    <!-- =====================================================
         PROCESS CARDS
    ====================================================== -->

    <div class="how-it-works__grid">


      <!-- ===================================================
           STEP 01
           DISCOVERY
      ==================================================== -->

      <article class="process-card">

        <div class="process-card__top">

          <span class="process-card__number">
            01
          </span>

          <span class="process-card__status">
            Discovery
          </span>

        </div>


        <div class="process-card__icon" aria-hidden="true">

          <span class="process-card__icon-core"></span>

          <span class="process-card__icon-ring"></span>

        </div>


        <h3 class="process-card__title">
          Paste a project or agent
        </h3>


        <p class="process-card__description">
          Start with a public website, GitHub repository,
          Technocore reference, DID, or ENS name.
        </p>


        <div class="process-card__footer">
          Website · GitHub · Technocore · DID · ENS
        </div>

      </article>


      <!-- ===================================================
           STEP 02
           SOURCE ESTABLISHMENT
      ==================================================== -->

      <article class="process-card">

        <div class="process-card__top">

          <span class="process-card__number">
            02
          </span>

          <span class="process-card__status">
            Source
          </span>

        </div>


        <div class="process-card__icon" aria-hidden="true">

          <span class="process-card__icon-core"></span>

          <span class="process-card__icon-ring"></span>

        </div>


        <h3 class="process-card__title">
          Scout establishes the source
        </h3>


        <p class="process-card__description">
          Scout follows the strongest public evidence it can establish
          and determines whether the project reaches a supported
          public GitHub source.
        </p>


        <div class="process-card__footer">
          Discovery first. Findings later.
        </div>

      </article>


      <!-- ===================================================
           STEP 03
           INVESTIGATION
      ==================================================== -->

      <article class="process-card">

        <div class="process-card__top">

          <span class="process-card__number">
            03
          </span>

          <span class="process-card__status">
            Investigation
          </span>

        </div>


        <div class="process-card__icon" aria-hidden="true">

          <span class="process-card__icon-core"></span>

          <span class="process-card__icon-ring"></span>


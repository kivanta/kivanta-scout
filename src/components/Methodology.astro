<!-- =========================================================
     KIVANTA SCOUT
     METHODOLOGY 1.0
========================================================= -->

<section
  class="methodology"
  id="methodology"
>

  <div class="methodology__inner">

    <!-- =====================================================
         LEFT SIDE
         METHODOLOGY INTRO
    ====================================================== -->

    <div class="methodology__intro">

      <!-- Eyebrow -->

      <div class="section-eyebrow">

        <span class="section-eyebrow__dot"></span>

        Methodology 1.0

      </div>


      <!-- Heading -->

      <h2 class="methodology__title">

        Five checks.

        <span>
          One evidence trail.
        </span>

      </h2>


      <!-- Description -->

      <p class="methodology__description">

        When Scout establishes a supported public source,
        it applies a versioned methodology designed to separate
        observed evidence from project claims.

      </p>


      <!-- Important Boundary -->

      <div class="methodology__boundary">

        <span class="methodology__boundary-icon">
          i
        </span>

        <p>

          A <strong>PASS</strong> means the available evidence supports
          the applicable check within Scout's defined scope.

          It is not a universal guarantee of safety.

        </p>

      </div>


      <!-- ===================================================
           STATUS LEGEND
      ==================================================== -->

      <div
        class="methodology__legend"
        aria-label="Methodology status meanings"
      >

        <span class="methodology__legend-item methodology__legend-item--pass">
          PASS
        </span>

        <span class="methodology__legend-item methodology__legend-item--caution">
          CAUTION
        </span>

        <span class="methodology__legend-item methodology__legend-item--unknown">
          UNKNOWN
        </span>

        <span class="methodology__legend-item methodology__legend-item--na">
          N/A where applicable
        </span>

      </div>

    </div>


    <!-- =====================================================
         RIGHT SIDE
         FIVE METHODOLOGY CHECKS
    ====================================================== -->

    <div class="methodology__checks">


      <!-- ===================================================
           CHECK 01
      ==================================================== -->

      <article class="methodology-check">

        <div class="methodology-check__number">
          01
        </div>


        <div class="methodology-check__content">

          <h3>
            What does this tool actually do?
          </h3>

          <p>
            Traces source behavior, entry points, configuration,
            dependencies, paths, and material effects.
          </p>

        </div>


        <div
          class="methodology-check__signal"
          aria-hidden="true"
        >
          <span></span>
        </div>

      </article>


      <!-- ===================================================
           CHECK 02
      ==================================================== -->

      <article class="methodology-check">

        <div class="methodology-check__number">
          02
        </div>


        <div class="methodology-check__content">

          <h3>
            Your Key, Password &amp; Sensitive Information
          </h3>

          <p>
            Examines how sensitive information is read,
            stored, transmitted, or exposed.
          </p>

        </div>


        <div
          class="methodology-check__signal"
          aria-hidden="true"
        >
          <span></span>
        </div>

      </article>


      <!-- ===================================================
           CHECK 03
      ==================================================== -->

      <article class="methodology-check">

        <div class="methodology-check__number">
          03
        </div>


        <div class="methodology-check__content">

          <h3>
            Where Does It Connect?
          </h3>

          <p>
            Establishes material network destinations
            and identifies unresolved connection paths.
          </p>

        </div>


        <div
          class="methodology-check__signal"
          aria-hidden="true"
        >
          <span></span>
        </div>

      </article>


      <!-- ===================================================
           CHECK 04
      ==================================================== -->

      <article class="methodology-check">

        <div class="methodology-check__number">
          04
        </div>


        <div class="methodology-check__content">

          <h3>
            Does It Match the Official Technocore Reference?
          </h3>

          <p>
            Compares observed behavior against Scout's
            versioned authoritative Technocore reference.
          </p>

        </div>


        <div
          class="methodology-check__signal"
          aria-hidden="true"
        >
          <span></span>
        </div>

      </article>


      <!-- ===================================================
           CHECK 05
      ==================================================== -->

      <article class="methodology-check">

        <div class="methodology-check__number">
          05
        </div>


        <div class="methodology-check__content">

          <h3>
            What Should I Know Before I Use It?
          </h3>

          <p>
            Surfaces material facts, limitations,
            and precautions established by the evidence.
          </p>

        </div>


        <div
          class="methodology-check__signal"
          aria-hidden="true"
        >
          <span></span>
        </div>

      </article>

    </div>

  </div>

</section>
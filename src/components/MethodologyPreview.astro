---
/* ========================================
   KIVANTA SCOUT — METHODOLOGY PREVIEW
======================================== */

import "../styles/methodology.css";


/* ========================================
   METHODOLOGY 1.0 — FIVE CHECKS
======================================== */

const checks = [
  "What does this tool actually do?",
  "How does it handle sensitive information like keys or passwords?",
  "Where does it connect?",
  "Does it match the official Technocore reference?",
  "What should I know before I use it?",
];
---

<section
  class="methodology"
  id="methodology"
  aria-labelledby="methodology-title"
>

  <div class="methodology__inner">

    <!-- ==================================
         SECTION HEADER
    =================================== -->

    <header class="methodology__header">

      <p class="methodology__eyebrow">
        METHODOLOGY 1.0
      </p>


      <h2
        class="methodology__title"
        id="methodology-title"
      >
        What Scout checks
      </h2>


    <p 
      class="methodology__description">
      Once Scout establishes the supported public code behind a tool,
      it applies five checks.
     </p>

    </header>


    <!-- ==================================
         FIVE METHODOLOGY CHECKS
    =================================== -->

    <ol class="methodology__list">

      {
        checks.map((check, index) => (

          <li class="methodology__item">

            <span class="methodology__number">
              {String(index + 1).padStart(2, "0")}
            </span>


            <span class="methodology__question">
              {check}
            </span>

          </li>

        ))
      }

    </ol>


    <!-- ==================================
         METHODOLOGY RESTRAINT
    =================================== -->

    <p class="methodology__note">
      If Scout can't establish something, it says so.
    </p>

  </div>

</section>
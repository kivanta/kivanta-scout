<!-- =========================================================
     KIVANTA SCOUT
     EVIDENCE
========================================================= -->

<section
  class="evidence"
  id="evidence"
>

  <div class="evidence__inner">

    <!-- =====================================================
         LEFT SIDE
         EVIDENCE INTRO
    ====================================================== -->

    <div class="evidence__intro">

      <!-- Eyebrow -->

      <div class="section-eyebrow">

        <span class="section-eyebrow__dot"></span>

        Evidence

      </div>


      <!-- Heading -->

      <h2 class="evidence__title">

        See what Scout saw.

        <span>
          Verify it yourself.
        </span>

      </h2>


      <!-- Description -->

      <p class="evidence__description">

        Scout keeps findings attached to the public evidence
        used to reach them, so you can inspect the source,
        understand the limitation, and follow the reference yourself.

      </p>


      <!-- ===================================================
           EVIDENCE PRINCIPLES
      ==================================================== -->

      <div class="evidence__principles">

        <!-- Principle 01 -->

        <div class="evidence-principle">

          <span class="evidence-principle__number">
            01
          </span>

          <div>

            <strong>
              Source snapshot
            </strong>

            <p>
              Findings stay tied to the source Scout actually inspected.
            </p>

          </div>

        </div>


        <!-- Principle 02 -->

        <div class="evidence-principle">

          <span class="evidence-principle__number">
            02
          </span>

          <div>

            <strong>
              Observation ≠ claim
            </strong>

            <p>
              Project documentation is kept separate from observed behavior.
            </p>

          </div>

        </div>


        <!-- Principle 03 -->

        <div class="evidence-principle">

          <span class="evidence-principle__number">
            03
          </span>

          <div>

            <strong>
              Limitations stay visible
            </strong>

            <p>
              Unknown or unsupported evidence is surfaced instead of hidden.
            </p>

          </div>

        </div>

      </div>

    </div>


    <!-- =====================================================
         RIGHT SIDE
         EXAMPLE EVIDENCE VIEW
    ====================================================== -->

    <div class="evidence-panel">

      <!-- ===================================================
           PANEL HEADER
      ==================================================== -->

      <div class="evidence-panel__header">

        <div>

          <span class="evidence-panel__eyebrow">
            Example evidence view
          </span>

          <h3>
            Investigation trail
          </h3>

        </div>


        <span class="evidence-panel__example">
          Illustrative
        </span>

      </div>


      <!-- ===================================================
           EXAMPLE FINDING
      ==================================================== -->

      <div class="evidence-finding">

        <div class="evidence-finding__meta">

          <span class="evidence-finding__check">
            Check 01
          </span>

          <span class="evidence-finding__status">
            PASS
          </span>

        </div>


        <strong class="evidence-finding__title">
          Observed behavior supported by inspected source
        </strong>


        <p class="evidence-finding__description">
          The finding is presented together with the evidence
          categories Scout used to reach it.
        </p>

      </div>


      <!-- ===================================================
           EVIDENCE TRAIL
      ==================================================== -->

      <div class="evidence-trail">


        <!-- Trail 01 -->

        <div class="evidence-trail__item">

          <div class="evidence-trail__signal">
            <span></span>
          </div>


          <div class="evidence-trail__content">

            <span class="evidence-trail__label">
              Supported source
            </span>

            <strong>
              Public repository established
            </strong>

          </div>


          <span class="evidence-trail__state">
            Established
          </span>

        </div>


        <!-- Trail 02 -->

        <div class="evidence-trail__item">

          <div class="evidence-trail__signal">
            <span></span>
          </div>


          <div class="evidence-trail__content">

            <span class="evidence-trail__label">
              Code evidence
            </span>

            <strong>
              Relevant source paths inspected
            </strong>

          </div>


          <span class="evidence-trail__state">
            Observed
          </span>

        </div>


        <!-- Trail 03 -->

        <div class="evidence-trail__item">

          <div class="evidence-trail__signal">
            <span></span>
          </div>


          <div class="evidence-trail__content">

            <span class="evidence-trail__label">
              Reference comparison
            </span>

            <strong>
              Authoritative Technocore behavior compared
            </strong>

          </div>


          <span class="evidence-trail__state">
            Compared
          </span>

        </div>

      </div>


      <!-- ===================================================
           OFFICIAL TECHNOCORE REFERENCE
      ==================================================== -->

      <div class="evidence-reference">

        <div class="evidence-reference__icon">
          ↗
        </div>


        <div class="evidence-reference__content">

          <span>
            Verify independently
          </span>

          <strong>
            Official Technocore reference
          </strong>

        </div>


        <!--
          The final verified Technocore room/reference URL
          will replace this reserved link slot before launch.
        -->

        <span
          class="evidence-reference__link evidence-reference__link--pending"
          aria-label="Official Technocore reference link will be connected before launch"
        >
          Reference ↗
        </span>

      </div>


      <!-- ===================================================
           PANEL FOOTER
      ==================================================== -->

      <div class="evidence-panel__footer">

        <span class="evidence-panel__footer-dot"></span>

        Evidence remains inspectable alongside the finding.

      </div>

    </div>

  </div>

</section>
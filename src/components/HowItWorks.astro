---
/* =========================================================
   KIVANTA SCOUT
   HOW SCOUT WORKS
========================================================= */

import "../styles/how-it-works.css";
---

<section
  class="how-it-works"
  id="how-it-works"
  aria-labelledby="how-it-works-title"
>

  <div class="how-it-works__inner">

    <!-- =====================================================
         SECTION INTRO
    ====================================================== -->

    <div class="how-it-works__intro">

      <div class="section-eyebrow">

        <span
          class="section-eyebrow__dot"
          aria-hidden="true"
        ></span>

        How Scout works

      </div>


      <h2
        class="how-it-works__title"
        id="how-it-works-title"
      >
        From a public reference

        <span>
          to evidence you can inspect.
        </span>
      </h2>


      <p class="how-it-works__description">
        Scout separates discovery from investigation.
        It identifies the project, establishes a supported public source,
        then applies the methodology only when that source is confirmed.
      </p>

    </div>


    <!-- =====================================================
         PROCESS CARDS
    ====================================================== -->

    <div class="how-it-works__grid">


      <!-- ===================================================
           STEP 01 — DISCOVERY
      ==================================================== -->

      <article class="process-card">

        <div class="process-card__top">

          <span class="process-card__number">
            01
          </span>

          <span class="process-card__status">
            Discovery
          </span>

        </div>


        <div
          class="process-card__icon"
          aria-hidden="true"
        >

          <span class="process-card__icon-core"></span>

          <span class="process-card__icon-ring"></span>

        </div>


        <h3 class="process-card__title">
          Paste a project or agent
        </h3>


        <p class="process-card__description">
          Start with a public website, GitHub repository,
          Technocore link, raw did:key, or ENS name.
        </p>


        <div class="process-card__footer">
          Website · GitHub · Technocore link · did:key · ENS
        </div>

      </article>


      <!-- ===================================================
           STEP 02 — SOURCE
      ==================================================== -->

      <article class="process-card">

        <div class="process-card__top">

          <span class="process-card__number">
            02
          </span>

          <span class="process-card__status">
            Source
          </span>

        </div>


        <div
          class="process-card__icon"
          aria-hidden="true"
        >

          <span class="process-card__icon-core"></span>

          <span class="process-card__icon-ring"></span>

        </div>


        <h3 class="process-card__title">
          Scout establishes the source
        </h3>


        <p class="process-card__description">
          Scout follows the strongest public evidence it can establish
          and determines whether the project reaches a supported
          public GitHub source.
        </p>


        <div class="process-card__footer">
          Discovery first. Findings later.
        </div>

      </article>


      <!-- ===================================================
           STEP 03 — INVESTIGATION
      ==================================================== -->

      <article class="process-card">

        <div class="process-card__top">

          <span class="process-card__number">
            03
          </span>

          <span class="process-card__status">
            Investigation
          </span>

        </div>


        <div
          class="process-card__icon"
          aria-hidden="true"
        >

          <span class="process-card__icon-core"></span>

          <span class="process-card__icon-ring"></span>

        </div>


        <h3 class="process-card__title">
          Inspect the evidence
        </h3>


        <p class="process-card__description">
          When the supported source is established,
          Scout applies its versioned methodology and produces
          evidence-backed findings you can inspect.
        </p>


        <div class="process-card__footer">
          Findings · Evidence · Limitations
        </div>

      </article>

    </div>


    <!-- =====================================================
         DISCOVERY GUARDRAIL
    ====================================================== -->

    <div class="how-it-works__guardrail">

      <div
        class="how-it-works__guardrail-icon"
        aria-hidden="true"
      >
        <span></span>
      </div>


      <div class="how-it-works__guardrail-copy">

        <strong>
          No supported source?
        </strong>

        <p>
          Scout stays in discovery mode and does not manufacture
          methodology or security findings.
        </p>

      </div>

    </div>

  </div>

</section>
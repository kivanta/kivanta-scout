---
/* ========================================
   KIVANTA SCOUT — PRIVACY
======================================== */

export const prerender = true;

import "../styles/global.css";

import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<!doctype html>

<html lang="en">

  <head>

    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width"
    />

    <meta
      name="description"
      content="Privacy information for Kivanta Scout."
    />

    <title>
      Privacy — Kivanta Scout
    </title>

  </head>


  <body>

    <Navbar />


    <main class="privacy-page">

      <article class="privacy-page__content">

        <p class="privacy-page__eyebrow">
          KIVANTA SCOUT
        </p>


        <h1>
          Privacy
        </h1>


        <p>
          Kivanta Scout is designed to investigate public project
          and tool references using public evidence.
        </p>


        <h2>
          Information you submit
        </h2>

        <p>
          When you use Scout, the public reference you submit may be
          processed so Scout can perform discovery and, where supported,
          run its investigation methodology.
        </p>

        <p>
          Scout does not require an account or wallet connection.
          Please do not submit private, confidential, or sensitive
          personal information.
        </p>


        <h2>
          Public evidence
        </h2>

        <p>
          Scout may retrieve and analyze publicly available information
          associated with a submitted reference, including public source
          repositories and other public technical references used by the
          investigation process.
        </p>


        <h2>
          Infrastructure data
        </h2>

        <p>
          Kivanta Scout is operated using Cloudflare infrastructure.
          Normal technical request information may be processed by the
          infrastructure used to operate, secure, and maintain the service.
        </p>


        <h2>
          Cookies and tracking
        </h2>

        <p>
          Scout does not currently use advertising or non-essential
          tracking cookies.
        </p>


        <h2>
          Scope
        </h2>

        <p>
          Scout reports what it can establish from public evidence.
          Investigation results are not a security certification,
          guarantee, or endorsement.
        </p>


        <h2>
          Updates
        </h2>

        <p>
          This privacy notice may be updated as Scout's functionality
          or infrastructure changes.
        </p>


        <p class="privacy-page__updated">
          Last updated: September 2026.
        </p>


        <a
          class="privacy-page__back"
          href="/"
        >
          ← Back to Kivanta Scout
        </a>

      </article>

    </main>


    <Footer />

  </body>

</html>


<style>

  /* ========================================
     PRIVACY PAGE — MINIMAL LAYOUT
  ======================================== */

  .privacy-page {
    width: min(100% - 2rem, 760px);
    margin-inline: auto;
    padding-block: clamp(4rem, 8vw, 7rem);
  }


  .privacy-page__content {
    display: grid;
    gap: 1.25rem;
  }


  .privacy-page__content h1 {
    margin: 0 0 1rem;
    font-size: clamp(2.25rem, 7vw, 4rem);
    line-height: 1;
    letter-spacing: -0.035em;
  }


  .privacy-page__content h2 {
    margin: 1.5rem 0 0;
    font-size: 1.15rem;
    line-height: 1.3;
  }


  .privacy-page__content p {
    margin: 0;
    line-height: 1.75;
  }


  .privacy-page__eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }


  .privacy-page__updated {
    margin-top: 1.5rem;
    opacity: 0.7;
  }


  .privacy-page__back {
    width: fit-content;
    margin-top: 1rem;
    text-decoration: none;
  }

</style>
---
/* ========================================
   KIVANTA SCOUT — ACTIVITY STRIP
======================================== */

import "../styles/activity-strip.css";
---

<section
  class="activity-strip"
  aria-label="Scout activity"
>

  <!-- ==================================
       MOBILE FIXED IDENTITY

       Hidden on tablet + desktop.
       On mobile this remains visible while
       the proof metrics continue moving.
  =================================== -->

  <div
    class="activity-strip__mobile-status"
    aria-hidden="true"
  >

    <span
      class="activity-strip__status-dot"
    ></span>

    <span>
      Scout Activity
    </span>

  </div>


  <!-- ==================================
       MARQUEE VIEWPORT
  =================================== -->

  <div class="activity-strip__viewport">

    <div class="activity-strip__track">

      <!-- ==================================
           FIRST ACTIVITY GROUP
      =================================== -->

      <div class="activity-strip__group">

        <!-- Scout Activity identity -->

        <div class="activity-strip__status">

          <span
            class="activity-strip__status-dot"
            aria-hidden="true"
          ></span>

          <span>
            Scout Activity
          </span>

        </div>


        <!-- Repositories investigated -->

        <div class="activity-strip__item">

          <span class="activity-strip__number">
            —
          </span>

          <span>
            Repositories investigated
          </span>

        </div>


        <!-- DIDs resolved -->

        <div class="activity-strip__item">

          <span class="activity-strip__number">
            —
          </span>

          <span>
            DIDs resolved
          </span>

        </div>


        <!-- Evidence receipts -->

        <div class="activity-strip__item">

          <span class="activity-strip__number">
            —
          </span>

          <span>
            Evidence receipts confirmed
          </span>

        </div>


        <!-- Supported sources -->

        <div class="activity-strip__item">

          <span class="activity-strip__number">
            —
          </span>

          <span>
            Supported sources established
          </span>

        </div>


        <!-- Feed status -->

        <div
          class="
            activity-strip__item
            activity-strip__updated
          "
        >

          <span
            class="activity-strip__pulse"
            aria-hidden="true"
          ></span>

          <span>
            Live feed pending
          </span>

        </div>

      </div>


      <!-- ==================================
           DUPLICATED GROUP

           Required for the seamless marquee.
           Hidden from assistive technology.
      =================================== -->

      <div
        class="activity-strip__group"
        aria-hidden="true"
      >

        <div class="activity-strip__status">

          <span
            class="activity-strip__status-dot"
          ></span>

          <span>
            Scout Activity
          </span>

        </div>


        <div class="activity-strip__item">

          <span class="activity-strip__number">
            —
          </span>

          <span>
            Repositories investigated
          </span>

        </div>


        <div class="activity-strip__item">

          <span class="activity-strip__number">
            —
          </span>

          <span>
            DIDs resolved
          </span>

        </div>


        <div class="activity-strip__item">

          <span class="activity-strip__number">
            —
          </span>

          <span>
            Evidence receipts confirmed
          </span>

        </div>


        <div class="activity-strip__item">

          <span class="activity-strip__number">
            —
          </span>

          <span>
            Supported sources established
          </span>

        </div>


        <div
          class="
            activity-strip__item
            activity-strip__updated
          "
        >

          <span
            class="activity-strip__pulse"
          ></span>

          <span>
            Live feed pending
          </span>

        </div>

      </div>

    </div>

  </div>

</section>
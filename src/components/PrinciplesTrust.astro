---
/* ========================================
   KIVANTA SCOUT — EVIDENCE
======================================== */

import "../styles/principles.css";


/* ========================================
   EVIDENCE PRINCIPLES
======================================== */

const evidencePrinciples = [
  {
    number: "01",
    status: "Evidence",
    title: "Source stays attached",
    description:
      "The finding stays connected to the public source and observations that support it.",
    footer: "Source · Observation · Finding",
  },
  {
    number: "02",
    status: "Interpretation",
    title: "Observation ≠ claim",
    description:
      "Scout separates what it directly observes from what the evidence allows it to conclude.",
    footer: "Observed · Established · Unknown",
  },
  {
    number: "03",
    status: "Limits",
    title: "Limitations stay visible",
    description:
      "If something cannot be established from the available evidence, Scout keeps that uncertainty visible.",
    footer: "PASS · CAUTION · UNKNOWN",
  },
];
---

<section
  class="principles"
  id="evidence"
  aria-labelledby="principles-title"
>

  <div class="principles__inner">

    <!-- ==================================
         SECTION INTRO
    =================================== -->

    <div class="principles__intro">

      <div class="principles__eyebrow">

        <span
          class="principles__eyebrow-dot"
          aria-hidden="true"
        ></span>

        EVIDENCE BEFORE TRUST

      </div>


      <h2
        class="principles__title"
        id="principles-title"
      >

        <span>
          See what Scout saw.
        </span>

        <span class="principles__title-secondary">
          Verify it yourself.
        </span>

      </h2>


      <p class="principles__description">
        Scout keeps evidence and limitations beside the finding
        so you can inspect how it got there.
      </p>

    </div>


    <!-- ==================================
         EVIDENCE CARDS
    =================================== -->

    <div class="principles__grid">

      {
        evidencePrinciples.map((principle) => (

          <article class="evidence-card">

            <!-- ============================
                 CARD TOP
            ============================= -->

            <div class="evidence-card__top">

              <span class="evidence-card__number">
                {principle.number}
              </span>


              <span class="evidence-card__status">
                {principle.status}
              </span>

            </div>


            <!-- ============================
                 CARD SIGNAL
            ============================= -->

            <div
              class="evidence-card__signal"
              aria-hidden="true"
            >

              <span class="evidence-card__signal-ring"></span>

              <span class="evidence-card__signal-core"></span>

            </div>


            <!-- ============================
                 CARD COPY
            ============================= -->

            <h3 class="evidence-card__title">
              {principle.title}
            </h3>


            <p class="evidence-card__description">
              {principle.description}
            </p>


            <!-- ============================
                 CARD FOOTER
            ============================= -->

            <div class="evidence-card__footer">
              {principle.footer}
            </div>

          </article>

        ))
      }

    </div>


    <!-- ==================================
         INDEPENDENT VERIFICATION RAIL
    =================================== -->

    <div class="principles__verify">

      <div
        class="principles__verify-icon"
        aria-hidden="true"
      >
        <span></span>
      </div>


      <div class="principles__verify-copy">

        <strong>
          Verify independently
        </strong>

        <p>
          Official Technocore reference
        </p>

      </div>


      <!--
        Reserved until we have a verified
        Technocore reference URL.
      -->

      <span class="principles__verify-reserved">
        Link reserved
      </span>

    </div>

  </div>

</section>
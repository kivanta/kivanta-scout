---
/* ========================================
   KIVANTA SCOUT — NAVBAR
======================================== */

import "../styles/navbar.css";
---

<header class="site-header">

  <div class="navbar">

    <!-- ==================================
         BRAND
    =================================== -->

    <a
      class="navbar__brand"
      href="/"
      aria-label="Kivanta Scout home"
    >

      <span
        class="navbar__brand-mark"
        aria-hidden="true"
      ></span>

      <span>
        Kivanta Scout
      </span>

    </a>


    <!-- ==================================
         PRIMARY NAVIGATION
    =================================== -->

    <nav
      class="navbar__nav"
      aria-label="Primary navigation"
    >

      <!-- How Scout Works -->

      <a
        class="navbar__link"
        href="#how-it-works"
      >
        How Scout Works
      </a>


      <!-- GitHub -->

      <a
        class="navbar__link"
        href="https://github.com/kivanta/kivanta-scout"
      >
        GitHub ↗
      </a>

    </nav>

  </div>

</header>
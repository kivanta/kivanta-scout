---
import "../styles/scout-input.css";
---

<form class="scout-input" id="scout-input">
  <label class="scout-input__label" for="scout-reference">
    Paste a public project or agent reference
  </label>

  <div class="scout-input__control">
    <input
      class="scout-input__field"
      id="scout-reference"
      name="reference"
      type="text"
      placeholder="github.com/... or did:key:z6Mkga....."
      autocomplete="off"
    />

    <button
      class="scout-input__button"
      type="button"
    >
      Scout it
    </button>
  </div>

  <p class="scout-input__capabilities">
    Website · GitHub · Technocore link · did:key · ENS
  </p>

  <p class="scout-input__trust">
    No wallet connection · No sign-up
  </p>
</form>
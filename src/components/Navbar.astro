---
/* ========================================
   KIVANTA SCOUT — NAVBAR
======================================== */

import "../styles/navbar.css";
---

<header class="site-header">

  <div
    class="navbar"
    data-menu-open="false"
  >

    <!-- ==================================
         BRAND
    =================================== -->

    <a
      class="navbar__brand"
      href="/"
      aria-label="Kivanta Scout home"
    >

      <span
        class="navbar__brand-mark"
        aria-hidden="true"
      ></span>

      <span>
        Kivanta Scout
      </span>

    </a>


    <!-- ==================================
         MOBILE MENU BUTTON
         Hidden on tablet + desktop
    =================================== -->

    <button
      class="navbar__menu-button"
      type="button"
      aria-label="Open navigation"
      aria-expanded="false"
      aria-controls="primary-navigation"
    >

      <span class="navbar__menu-line"></span>
      <span class="navbar__menu-line"></span>

    </button>


    <!-- ==================================
         PRIMARY NAVIGATION
    =================================== -->

    <nav
      class="navbar__nav"
      id="primary-navigation"
      aria-label="Primary navigation"
    >

      <a
        class="navbar__link"
        href="#how-it-works"
      >
        How Scout Works
      </a>

      <a
        class="navbar__link"
        href="https://github.com/kivanta/kivanta-scout"
        target="_blank"
        rel="noopener noreferrer"
      >
        GitHub ↗
      </a>

    </nav>

  </div>

</header>


<script>
  /* ========================================
     MOBILE NAVIGATION
  ======================================== */

  const navbar =
    document.querySelector(".navbar");

  const menuButton =
    document.querySelector(".navbar__menu-button");

  const nav =
    document.querySelector(".navbar__nav");


  if (
    navbar instanceof HTMLElement &&
    menuButton instanceof HTMLButtonElement &&
    nav instanceof HTMLElement
  ) {

    const closeMenu = () => {

      navbar.dataset.menuOpen =
        "false";

      menuButton.setAttribute(
        "aria-expanded",
        "false"
      );

      menuButton.setAttribute(
        "aria-label",
        "Open navigation"
      );

    };


    const openMenu = () => {

      navbar.dataset.menuOpen =
        "true";

      menuButton.setAttribute(
        "aria-expanded",
        "true"
      );

      menuButton.setAttribute(
        "aria-label",
        "Close navigation"
      );

    };


    menuButton.addEventListener(
      "click",
      () => {

        const isOpen =
          navbar.dataset.menuOpen ===
          "true";

        if (isOpen) {
          closeMenu();
        } else {
          openMenu();
        }

      }
    );


    nav
      .querySelectorAll("a")
      .forEach((link) => {

        link.addEventListener(
          "click",
          closeMenu
        );

      });


    window.addEventListener(
      "resize",
      () => {

        if (
          window.innerWidth >
          576
        ) {
          closeMenu();
        }

      }
    );

  }
</script>
<!-- =========================================================
     KIVANTA SCOUT
     LIVE TECHNOCORE / SCOUT ACTIVITY STRIP
========================================================= -->

<section
  class="activity-strip"
  aria-label="Technocore and Scout network activity"
>

  <!-- =======================================================
       MOVING TRACK
  ======================================================== -->

  <div class="activity-strip__track">

    <!-- =====================================================
         PRIMARY METRIC GROUP
    ====================================================== -->

    <div class="activity-strip__group">

      <!-- Network Status -->
      <span class="activity-strip__status">
        <span class="activity-strip__status-dot"></span>

        Technocore network
      </span>


      <!-- Public Rooms -->
      <span class="activity-strip__item">
        <strong
          class="activity-strip__number"
          data-metric="rooms-indexed"
        >
          —
        </strong>

        Public rooms indexed
      </span>


      <!-- Projects Investigated -->
      <span class="activity-strip__item">
        <strong
          class="activity-strip__number"
          data-metric="projects-investigated"
        >
          —
        </strong>

        Projects investigated
      </span>


      <!-- Evidence Receipts -->
      <span class="activity-strip__item">
        <strong
          class="activity-strip__number"
          data-metric="receipts-verified"
        >
          —
        </strong>

        Evidence receipts verified
      </span>


      <!-- Supported Sources -->
      <span class="activity-strip__item">
        <strong
          class="activity-strip__number"
          data-metric="supported-sources"
        >
          —
        </strong>

        Supported sources established
      </span>


      <!-- Latest Update -->
      <span class="activity-strip__item activity-strip__updated">
        <span class="activity-strip__pulse"></span>

        Live metrics connect here
      </span>

    </div>


    <!-- =====================================================
         DUPLICATE GROUP
         Creates the seamless continuous movement.
    ====================================================== -->

    <div
      class="activity-strip__group"
      aria-hidden="true"
    >

      <span class="activity-strip__status">
        <span class="activity-strip__status-dot"></span>

        Technocore network
      </span>


      <span class="activity-strip__item">
        <strong class="activity-strip__number">
          —
        </strong>

        Public rooms indexed
      </span>


      <span class="activity-strip__item">
        <strong class="activity-strip__number">
          —
        </strong>

        Projects investigated
      </span>


      <span class="activity-strip__item">
        <strong class="activity-strip__number">
          —
        </strong>

        Evidence receipts verified
      </span>


      <span class="activity-strip__item">
        <strong class="activity-strip__number">
          —
        </strong>

        Supported sources established
      </span>


      <span class="activity-strip__item activity-strip__updated">
        <span class="activity-strip__pulse"></span>

        Live metrics connect here
      </span>

    </div>

  </div>

</section>
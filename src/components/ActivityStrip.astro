---
/* =========================================================
   KIVANTA SCOUT
   LIVE SCOUT ACTIVITY STRIP
========================================================= */

import "../styles/activity-strip.css";
---

<section
  class="activity-strip"
  aria-label="Scout investigation activity"
>

  <!-- =====================================================
       MOVING TRACK
  ====================================================== -->

  <div class="activity-strip__track">

    <!-- ===================================================
         PRIMARY ACTIVITY GROUP
    ==================================================== -->

    <div class="activity-strip__group">

      <!-- Scout Activity Status -->

      <span class="activity-strip__status">

        <span
          class="activity-strip__status-dot"
          aria-hidden="true"
        ></span>

        Scout activity

      </span>


      <!-- Repositories Investigated -->

      <span class="activity-strip__item">

        <strong
          class="activity-strip__number"
          data-metric="repos-investigated"
        >
          —
        </strong>

        Repositories investigated

      </span>


      <!-- DIDs Resolved -->

      <span class="activity-strip__item">

        <strong
          class="activity-strip__number"
          data-metric="dids-resolved"
        >
          —
        </strong>

        DIDs resolved

      </span>


      <!-- Evidence Receipts -->

      <span class="activity-strip__item">

        <strong
          class="activity-strip__number"
          data-metric="receipts-confirmed"
        >
          —
        </strong>

        Evidence receipts confirmed

      </span>


      <!-- Supported Sources -->

      <span class="activity-strip__item">

        <strong
          class="activity-strip__number"
          data-metric="supported-sources"
        >
          —
        </strong>

        Supported sources established

      </span>


      <!-- Feed State -->

      <span
        class="
          activity-strip__item
          activity-strip__updated
        "
      >

        <span
          class="activity-strip__pulse"
          aria-hidden="true"
        ></span>

        Live feed pending

      </span>

    </div>


    <!-- ===================================================
         DUPLICATE GROUP

         Required for seamless marquee movement.
         Hidden from assistive technology because
         it repeats the exact same information.
    ==================================================== -->

    <div
      class="activity-strip__group"
      aria-hidden="true"
    >

      <span class="activity-strip__status">

        <span class="activity-strip__status-dot"></span>

        Scout activity

      </span>


      <span class="activity-strip__item">

        <strong class="activity-strip__number">
          —
        </strong>

        Repositories investigated

      </span>


      <span class="activity-strip__item">

        <strong class="activity-strip__number">
          —
        </strong>

        DIDs resolved

      </span>


      <span class="activity-strip__item">

        <strong class="activity-strip__number">
          —
        </strong>

        Evidence receipts confirmed

      </span>


      <span class="activity-strip__item">

        <strong class="activity-strip__number">
          —
        </strong>

        Supported sources established

      </span>


      <span
        class="
          activity-strip__item
          activity-strip__updated
        "
      >

        <span class="activity-strip__pulse"></span>

        Live feed pending

      </span>

    </div>

  </div>

</section>